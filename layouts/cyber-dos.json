{
  "id": "root",
  "type": "column",
  "theme": "cyber-dos",
  "colors": {
    "accent": "#2176c7",
    "accent_foreground": "#eae3cb",
    "solid": "#2176c7",
    "solid_foreground": "#eae3cb",
    "ansi0": "#002831",
    "ansi1": "#d11c24",
    "ansi2": "#6cbe6c",
    "ansi3": "#a57706",
    "ansi4": "#2176c7",
    "ansi5": "#c61c6f",
    "ansi6": "#259286",
    "ansi7": "#b9b2a0",
    "ansi8": "#006488",
    "ansi9": "#f5163b",
    "ansi10": "#51ef84",
    "ansi11": "#b27e28",
    "ansi12": "#178ec8",
    "ansi13": "#e24d8e",
    "ansi14": "#00b39e",
    "ansi15": "#c9c2b2",
    "background": "#001e27",
    "blocked": "#d11c24",
    "border": "#003748",
    "canvas": "#001e27",
    "chrome": "#002831",
    "dim": "#7a8f8e",
    "done": "#259286",
    "foreground": "#8fb3b4",
    "hover": "#003748",
    "idle": "#7a8f8e",
    "input": "#006488",
    "muted": "#7a8f8e",
    "popover": "#002831",
    "raised": "#003748",
    "selected": "#003748",
    "selection": "#003748",
    "surface": "#003748",
    "unknown": "#7a8f8e",
    "working": "#6cbe6c"
  },
  "background": "canvas",
  "font": "FiraCode Nerd Font Light",
  "font_size": 18,
  "ui_font": "JetBrains Mono",
  "terminal_padding": [
    10,
    12
  ],
  "terminal_opacity": 1,
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "terminal_menu": "cyber-dos-menu",
  "preview": "layouts/cyber-dos.svg",
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "topbar",
      "type": "row",
      "size": {
        "px": 32
      },
      "background": "chrome",
      "window_drag": true,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "cyber-dos-workspace-chrome"
          },
          "size": {
            "px": 300
          },
          "background": "chrome"
        },
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "cyber-dos-tabs"
          },
          "background": "chrome"
        },
        {
          "id": "readout",
          "type": "block",
          "content": {
            "mod": "cyber-dos-workspace-chrome",
            "props": {
              "readout": true
            }
          },
          "size": {
            "px": 150
          },
          "background": "chrome",
          "hidden": true
        }
      ]
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 300
          },
          "min": 44,
          "max": 520,
          "background": "chrome",
          "gap": 4,
          "padding": [
            0,
            0
          ],
          "resizable": true,
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "cyber-dos-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 110,
              "background": "surface",
              "border": {
                "width": 1,
                "color": "accent"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "cyber-dos-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 110,
              "background": "surface",
              "border": {
                "width": 1,
                "color": "accent"
              }
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "content": {
                "mod": "cyber-dos-workspace-chrome",
                "props": {
                  "footer": true
                }
              },
              "size": {
                "px": 64
              },
              "background": "surface",
              "border": {
                "width": 1,
                "color": "accent"
              }
            }
          ]
        },
        {
          "id": "work",
          "type": "column",
          "background": "canvas",
          "gap": 0,
          "children": [
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "cyber-dos-pane"
                        },
                        "reveal": "always",
                        "height": 34,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "input"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 0,
                      "gap": 6,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "size": {
                    "px": 380
                  },
                  "min": 260,
                  "max": 900,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "changes",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "cyber-dos-files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "cyber-dos-changes"
                          }
                        }
                      ]
                    }
                  ]
                }
              ],
              "gap": 0,
              "divider": {
                "width": 1,
                "color": "border"
              }
            }
          ]
        }
      ],
      "background": "canvas",
      "padding": [
        0,
        4
      ],
      "gap": 4
    }
  ]
}